  "newsArticles": [
    {
      "id": "news_1793557874344",
      "title": "اطلاق الموقع الرسمي لسيرفر لي سيرفر 𝑾𝒉𝒊𝒕𝒆 𝑲𝒊𝒏𝒈𝒅𝒐𝒎",
      "pinned": true,
      "content": "👑 𝑾𝒉𝒊𝒕𝒆 𝑲𝒊𝒏𝒈𝒅𝒐𝒎\n\nنعلن رسميًا عن افتتاح واكتمال الموقع الرسمي للسيرفر!\n\nبعد العمل على تطوير الموقع وتجهيزه أصبح الموقع الرسمي لـ 𝑾𝒉𝒊𝒕𝒆 𝑲𝒊𝒏𝒈𝒅𝒐𝒎 جاهزًا لاستقبالكم ليكون المكان الأساسي لمتابعة كل ما يخص السيرفر ولاعبيه\n\n🌐 إيه اللي هتلاقوه في الموقع؟\n\n📢 آخر أخبار السيرفر\nتابعوا آخر المستجدات والإعلانات وكل ما هو جديد داخل مجتمعنا\n\n🏆 تقييمات اللاعبين بالتفاصيل\nاطّلعوا على تقييمات اللاعبين ونتائج اختباراتهم والتفاصيل الخاصة بكل لاعب تم تقييمه\n\n📊 Leaderboard للاعبين\nتابعوا ترتيب اللاعبين الذين تم تقييمهم وقارنوا بين مستوياتهم وشوفوا مين متصدر القائمة\n\n⚔️ والمزيد قادم!\nالموقع هو خطوة جديدة في تطوير مجتمعنا وتنظيم نظام التقييمات وتقديم تجربة أفضل للاعبين\n\n🔥 دي مجرد البداية واللي جاي أكبر!\n\nندعو الجميع لزيارة الموقع واكتشاف كل ما يقدمه والانضمام إلينا في رحلتنا نحو تطوير مجتمع 𝑾𝒉𝒊𝒕𝒆 𝑲𝒊𝒏𝒈𝒅𝒐𝒎\n\n━━━━━━━━━━━━━━━━━━\n\n𝑾𝒉𝒊𝒕𝒆 𝑲𝒊𝒏𝒈𝒅𝒐𝒎\nOne Kingdom One Standard 👑",
      "category": "إعلان هام",
      "imageUrl": "https://res.cloudinary.com/r1g1gh0s/image/upload/v1793717017/white_kingdom/ua8pfu3aezalw2mt45jo.webp",
      "createdAt": "2026-11-01T18:31:14.344Z",
      "updatedAt": "2026-11-03T14:43:39.953Z"
    }
  ],
