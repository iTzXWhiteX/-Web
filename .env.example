# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="https://ais-dev-dp23obbeui2s6ee2zzaska-953765324818.europe-west2.run.app"

# DISCORD OAUTH CONFIGURATION
# Register in Discord Developer Portal -> OAuth2 -> General
# Add Redirect URIs:
# 1) https://ais-dev-dp23obbeui2s6ee2zzaska-953765324818.europe-west2.run.app/auth/callback
# 2) https://ais-pre-dp23obbeui2s6ee2zzaska-953765324818.europe-west2.run.app/auth/callback
DISCORD_CLIENT_ID="1564698063744925949"
DISCORD_CLIENT_SECRET=""

# Optional explicit redirect URI override (leave empty for automatic dynamic detection)
DISCORD_REDIRECT_URI=""

# Comma-separated Discord User IDs who will automatically have Administrator access
ADMIN_DISCORD_IDS="1103986702650802206"

# POSTGRESQL PERSISTENCE DATABASE (EthioDeploy or Cloud SQL)
DATABASE_URL="postgres://user:password@host:5432/dbname"

# CLOUDINARY PERMANENT EXTERNAL IMAGE STORAGE
# Obtain these from your Cloudinary dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Secret key used for signing session tokens and OAuth state HMAC
SESSION_SECRET="white_kingdom_pvp_secret_key_2026"
